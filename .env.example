# Spring Boot Database Configuration (Never commit real credentials)
DB_URL=jdbc:mysql://localhost:3306/job_matching_system
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Optional FastAPI NLP Service URL
NLP_SERVICE_URL=http://localhost:8000

# Resume Upload Directory (relative or absolute path outside public web root)
RESUME_UPLOAD_DIR=uploads/resumes

# React Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8080
